{
  "name": "youtubedownloader",
  "productName": "YouTube Downloader",
  "version": "2.0.0",
  "description": "A simple YouTube video/audio downloader",
  "main": "./out/main/index.js",
  "author": {
    "name": "Loyd Fassi",
    "email": "loydfassi@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loydfassi/youtubeDownloader.git"
  },
  "bugs": {
    "url": "https://github.com/loydfassi/youtubeDownloader/issues"
  },
  "keywords": [
    "youtube",
    "downloader",
    "video",
    "mp3",
    "mp4",
    "electron"
  ],
  "scripts": {
    "postinstall": "node scripts/download-ytdlp.mjs",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test-watch": "vitest",
    "package": "npm run build && electron-builder --publish never",
    "package-win": "npm run build && electron-builder --win --publish never",
    "package-win-portable": "npm run build && electron-builder --win portable --publish never",
    "package-mac": "npm run build && electron-builder --mac --publish never",
    "package-linux": "npm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^3.2.6"
  },
  "build": {
    "appId": "org.lfassi.youtubedownloader",
    "productName": "YouTube Downloader",
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      }
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.ico"
    },
    "portable": {
      "artifactName": "YouTube-Downloader-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": true,
      "installerLanguages": [
        "en_US",
        "fr_FR"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "resources/icons",
      "category": "AudioVideo"
    }
  }
}
